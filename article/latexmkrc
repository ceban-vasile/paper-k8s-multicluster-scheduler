# latexmk configuration (alternative to Tectonic): XeLaTeX + BibTeX backend of biblatex
$pdf_mode = 5;          # xelatex -> xdvipdfmx
$bibtex_use = 2;        # run bibtex when needed; delete .bbl on cleanup
$xelatex = 'xelatex -interaction=nonstopmode -file-line-error -synctex=1 %O %S';
@default_files = ('main.tex');
