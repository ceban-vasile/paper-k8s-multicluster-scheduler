%% Fig. 2 - Proposed architecture. Grey = proposed components, white = existing Karmada components.
%% Export: mermaid.live in LIGHT mode -> Actions -> PNG -> save as article/figures/architecture.png
flowchart TB
  probe["<b>Latency probe</b> (at the client side)<br/>RTT to cluster ingress"]:::proposed

  subgraph MC["Member clusters"]
    direction LR
    m1["Member cluster<br/>kube-scheduler"]
    m2["Member cluster<br/>kube-scheduler"]
    m3["Member cluster<br/>kube-scheduler"]
  end

  subgraph CP["Karmada control plane"]
    direction TB
    ctrl["Cluster status controller<br/>(every 10 s)"]
    api["<b>karmada-apiserver</b><br/>Cluster: resourceSummary, annotations<br/>ResourceBinding"]
    bctl["Binding and execution<br/>controllers"]
    subgraph SCH["Extended karmada-scheduler (custom binary, WithPlugin)"]
      direction LR
      intree["In-tree plugins<br/>Filter, Score"]
      lat["<b>NetLatency</b><br/>Filter (H4, optional)"]:::optional
      nrs["<b>NetResourceScore</b><br/>Score, NormalizeScore"]:::proposed
      cap["<b>CapacityFit</b><br/>Filter (H2, H3)"]:::proposed
      est["Replica estimators<br/>(accurate: optional service)"]
    end
  end

  probe -. "RTT probes" .-> MC
  probe -- "patch annotations<br/>rtt-ms, measured-at, samples" --> api
  MC -- "nodes, pods" --> ctrl
  ctrl -- "resourceSummary" --> api
  api -- "cluster snapshot" --> SCH
  SCH -- "spec.clusters" --> api
  cap -- "m<sub>c</sub>(w)" --> est
  api --> bctl
  bctl -- "Work objects" --> MC
  intree ~~~ lat ~~~ nrs

  classDef proposed fill:#d9d9d9,stroke:#000000,stroke-width:2px;
  classDef optional fill:#d9d9d9,stroke:#000000,stroke-width:2px,stroke-dasharray:6 4;
