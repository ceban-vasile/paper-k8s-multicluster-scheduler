% csmd.sty -- UNOFFICIAL LaTeX reproduction of the CSMD-UTM 2026 Word article template
% (Paper_template-Conf-SMD-UTM-2026-eng.docx, https://csmd.utm.md/en/templates-2026/).
% The organisers provide no LaTeX template. Values below were read from the .docx (text and XML);
% assumptions are marked "ASSUMPTION". See ../conference_requirements.md.
% Engine: XeLaTeX / Tectonic (fontspec). Bibliography: biblatex with the BibTeX backend.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{csmd}[2026/11/10 Unofficial CSMD-UTM article layout]

% ---------- Page: A4 portrait; margins top/bottom/right 2.0 cm, left 2.5 cm ----------
% Header text sits ~1.0 cm from the top edge, footer ~1.25 cm from the bottom edge (docx: header=567, footer=709 twips).
\RequirePackage[a4paper,top=2cm,bottom=2cm,right=2cm,left=2.5cm,
  headheight=15pt,headsep=0.45cm,footskip=0.9cm]{geometry}

% ---------- Fonts: Times New Roman 12 pt ----------
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\IfFontExistsTF{Times New Roman}
  {\setmainfont{Times New Roman}}
  {\setmainfont{TeX Gyre Termes}}% metric-compatible fallback
\setmathfont{texgyretermes-math.otf}% loaded by file name (works in Tectonic and TeX Live)

% ---------- Paragraphs: 1.5 line spacing, first-line indent 1.25 cm ----------
\RequirePackage{setspace}
\onehalfspacing
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1.5em}% avoids overfull lines with long technical terms

% ---------- Equations: ~3 pt clear space above and below (template) ----------
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{3pt plus 1pt}%
  \setlength{\belowdisplayskip}{3pt plus 1pt}%
  \setlength{\abovedisplayshortskip}{3pt plus 1pt}%
  \setlength{\belowdisplayshortskip}{3pt plus 1pt}}

% ---------- Headings: 12 pt bold ----------
% ASSUMPTION: the template's own headings are unnumbered and inconsistent; numbered headings
% are used here so that sections can be cross-referenced. Remove the numbers via \setcounter{secnumdepth}{0}.
\RequirePackage{titlesec}
\titleformat{\section}{\normalsize\bfseries}{\thesection.}{0.5em}{}
\titleformat{\subsection}{\normalsize\bfseries\itshape}{\thesubsection.}{0.5em}{}
\titlespacing*{\section}{0pt}{9pt plus 2pt}{3pt}
\titlespacing*{\subsection}{0pt}{6pt plus 2pt}{2pt}

% ---------- Header and footer (template header/footer text) ----------
\RequirePackage{fancyhdr}
\newcommand{\csmdfooter}{Chisinau, Vol.~N}% set via \setcsmdfooter{...} in main.tex
\newcommand{\setcsmdfooter}[1]{\renewcommand{\csmdfooter}{#1}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\footnotesize\itshape Technical Scientific Conference of Undergraduate, Master and PhD Students, Technical University of Moldova}
\fancyfoot[L]{\footnotesize\csmdfooter}% ASSUMPTION: alignment of footer text
\fancyfoot[C]{\footnotesize -\,\thepage\,-}
\fancypagestyle{plain}{}% first page uses the same style

% ---------- Captions: bold, 11 pt; figures below, tables above ("Table 1" on its own line) ----------
\RequirePackage{caption}
\captionsetup{font={small,bf},labelfont=bf,textfont=bf,justification=centering,singlelinecheck=true}
\captionsetup[figure]{labelsep=period,name=Figure,skip=4pt}
\captionsetup[table]{labelsep=newline,name=Table,skip=4pt,position=top}

% ---------- Tables: no vertical lines, full width ----------
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}

% ---------- Title block ----------
\newcommand{\csmdtitle}[1]{\begin{center}\begin{singlespace}{\fontsize{14}{16}\selectfont\bfseries\MakeUppercase{#1}\par}\end{singlespace}\end{center}}
\newcommand{\csmdauthors}[1]{\begin{center}{\bfseries #1\par}\end{center}\vspace{-6pt}}
\newcommand{\csmdaffiliation}[1]{\begin{center}\begin{singlespace}{\fontsize{10}{12}\selectfont\itshape #1\par}\end{singlespace}\end{center}\vspace{-6pt}}
\newcommand{\csmdcorresponding}[1]{\begin{center}{\fontsize{10}{12}\selectfont #1\par}\end{center}\vspace{-6pt}}
\newcommand{\csmdtutor}[1]{\begin{center}{\fontsize{10}{12}\selectfont #1\par}\end{center}}
\newenvironment{csmdabstract}{\par\noindent\textbf{Abstract.}\ \itshape\ignorespaces}{\par}
\newcommand{\csmdkeywords}[1]{\par\smallskip\noindent\textbf{Keywords:}\ {\itshape #1}\par\medskip}

% ---------- Cross-references in template style: Fig. 1, Tab. 1, Eq. (1) ----------
\RequirePackage[hidelinks]{hyperref}
\RequirePackage[nameinlink,noabbrev]{cleveref}
\crefname{figure}{Fig.}{Figs.}\Crefname{figure}{Fig.}{Figs.}
\crefname{table}{Tab.}{Tabs.}\Crefname{table}{Tab.}{Tabs.}
\crefname{equation}{Eq.}{Eqs.}\Crefname{equation}{Eq.}{Eqs.}
\crefname{section}{Section}{Sections}\Crefname{section}{Section}{Sections}
\crefname{subsection}{Section}{Sections}\Crefname{subsection}{Section}{Sections}
\crefname{algorithm}{Algorithm}{Algorithms}\Crefname{algorithm}{Algorithm}{Algorithms}
\creflabelformat{equation}{(#2#1#3)}

% ---------- Bibliography: numeric, order of citation, CSMD reference style (approximation) ----------
% Target (template + Zotero CSL "press-utm-md"):
%   AUTHOR, A.B.; AUTHOR, C.D. Title. Journal Year, Volume(Issue), pp. pages. https://doi.org/...
\RequirePackage[backend=bibtex,style=numeric-comp,sorting=none,giveninits=true,
  maxbibnames=6,minbibnames=3,isbn=false,url=true,doi=true,eprint=true]{biblatex}
\DeclareNameAlias{default}{family-given}
\renewcommand*{\mkbibnamefamily}[1]{\MakeUppercase{#1}}
\renewcommand*{\revsdnamepunct}{\addcomma}
\DeclareDelimFormat[bib]{multinamedelim}{\addsemicolon\space}
\DeclareDelimFormat[bib]{finalnamedelim}{\addsemicolon\space}
\DeclareDelimFormat[bib]{andothersdelim}{\addsemicolon\space}
\DefineBibliographyStrings{english}{andothers={et al\adddot}}
\DeclareFieldFormat*{title}{#1}
\DeclareFieldFormat*{booktitle}{\mkbibemph{#1}}
\DeclareFieldFormat{journaltitle}{\mkbibemph{#1}}
\DeclareFieldFormat[article]{volume}{\mkbibemph{#1}}
\DeclareFieldFormat[article]{number}{\mkbibparens{#1}}
\DeclareFieldFormat[article]{year}{\mkbibbold{#1}}
\DeclareFieldFormat{pages}{pp.\addnbspace#1}
\DeclareFieldFormat{doi}{\url{https://doi.org/#1}}
\DeclareFieldFormat{url}{Available online:\space\url{#1}}
\renewcommand*{\intitlepunct}{\addspace}
\renewbibmacro{in:}{\ifentrytype{article}{}{\printtext{\bibstring{in}\intitlepunct}}}
\renewbibmacro*{journal+issuetitle}{%
  \usebibmacro{journal}%
  \setunit*{\addspace}%
  \printfield{year}%
  \setunit{\addcomma\space}%
  \printfield{volume}%
  \printfield{number}%
  \setunit{\addcomma\space}%
  \printfield{eid}}
\renewbibmacro*{note+pages}{%
  \printfield{note}%
  \setunit{\addcomma\space}%
  \printfield{pages}}
\defbibheading{csmd}[References]{\section*{#1}}
\setlength{\bibitemsep}{0pt}
\renewcommand*{\bibfont}{\normalsize\raggedright\setstretch{1}}% \singlespacing breaks the .bbl input

\endinput
